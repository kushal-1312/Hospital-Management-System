# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/hospital_db

# Authentication - replace both secrets with independent random values
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=replace_with_another_random_secret_at_least_32_characters
JWT_REFRESH_EXPIRE=7d
REFRESH_COOKIE_DAYS=7
AUDIT_HMAC_KEY=replace_with_a_third_independent_random_secret_32_chars

# Email (required for password reset and email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@medcare-hms.local
EMAIL_FROM_NAME=MedCare HMS

# Account security
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=15
RESET_TOKEN_EXPIRE=10
OTP_EXPIRE=5
TOTP_APP_NAME=MedCare HMS

# Request limits
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX=1000
REQUEST_BODY_LIMIT=100kb
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=35000
KEEP_ALIVE_TIMEOUT_MS=65000
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:3010

# Logging
LOG_LEVEL=info
METRICS_TOKEN=replace_with_a_private_metrics_scrape_token
BUILD_SHA=development
TRUST_PROXY_HOPS=1

# Redis cache and Bull queues
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_REQUIRED=false
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
CACHE_TTL_DASHBOARD=30
CACHE_TTL_STATS=60
CACHE_TTL_MEDICINES=120
JOB_CONCURRENCY=3
