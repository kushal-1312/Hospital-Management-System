{
  "name": "hms-backend",
  "version": "3.0.0",
  "description": "MedCare One enterprise hospital management API",
  "main": "server.js",
  "scripts": {
    "start":   "node server.js",
    "dev":     "nodemon server.js",
    "seed":    "node utils/seeder.js",
    "seed:pharmacy": "node utils/seeder.js --pharmacy",
    "worker":  "node workers/jobWorker.js",
    "test":        "jest --runInBand --forceExit",
    "test:unit":   "jest tests/unit --runInBand --forceExit",
    "test:int":    "jest tests/integration --runInBand --forceExit",
    "test:watch":  "jest --watch",
    "test:cov":    "jest --coverage --runInBand --forceExit"
  },
  "dependencies": {
    "@socket.io/redis-adapter": "^8.3.0",
    "@prometheus-io/client": "^0.16.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.3.4",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.24.4",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.1",
    "otplib": "^12.0.1",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "supertest": "^7.2.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.10"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
