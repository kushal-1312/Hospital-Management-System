# Compose deployment values. Copy to .env and replace every placeholder.
JWT_SECRET=replace_with_64_random_characters
JWT_REFRESH_SECRET=replace_with_a_different_64_character_value
AUDIT_HMAC_KEY=replace_with_a_third_independent_64_character_value
METRICS_TOKEN=replace_with_a_private_metrics_token
BUILD_SHA=local

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@example-hospital.com
EMAIL_FROM_NAME=MedCare One

RATE_LIMIT_MAX=1000
